# Stargram production TURN configuration for coturn.
# This example uses the TURN REST API / ephemeral credentials mode.
#
# The matching application-side secret is TURN_SECRET.
# Do NOT commit the real secret or TLS private key.

listening-port=3478
tls-listening-port=5349

fingerprint
use-auth-secret

# Replace with the same secret configured as TURN_SECRET on the app server.
static-auth-secret=CHANGE_ME

# Public DNS name used as the TURN realm.
realm=turn.example.com

# Keep the relay range bounded and open exactly this UDP range in the firewall.
min-port=49160
max-port=49200

# Safer defaults for a public relay.
no-multicast-peers
no-loopback-peers
stale-nonce=600

# Production TLS (recommended for TURN over TLS/TCP fallback).
# cert=/etc/coturn/fullchain.pem
# pkey=/etc/coturn/privkey.pem

# If the TURN host is behind NAT, configure the public address explicitly:
# external-ip=PUBLIC_IP/PRIVATE_IP

# Optional logging:
# log-file=/var/log/turnserver/turn.log
