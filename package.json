{
  "name": "telegram-messenger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "server": "node ./server",
    "lint": "eslint .",
    "db:cleanup-legacy-room-messages": "node ./scripts/cleanup-legacy-room-messages.mjs",
    "test:integration": "node --test tests/socket.integration.test.mjs",
    "test:turn": "node --test tests/turn-credentials.test.mjs",
    "test:call-reliability": "node --test tests/call-reliability.test.mjs",
    "test:backlog": "node --test tests/backlog.test.mjs",
    "test:security": "node --test tests/csrf.test.mjs",
    "test:multi-node": "node --test tests/multi-node.integration.test.mjs",
    "test:webrtc-e2e": "playwright test tests/webrtc.e2e.spec.mjs --workers=1",
    "validate:production-env": "node ./scripts/validate-production-env.mjs",
    "test:production-config": "node --test tests/production-config.test.mjs",
    "validate:production-network": "node ./scripts/validate-production-network.mjs",
    "test:deployment": "bash -n deploy/setup-vps.sh deploy/deploy-vps.sh"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "axios": "^1.7.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcrypt": "^6.0.0",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^16.4.7",
    "emoji-picker-react": "^4.12.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "next": "^16.3.8",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "tailwindcss": "^4.0.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-lottie-player": "^2.1.0",
    "react-toastify": "^11.0.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-presigned-post": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "uuid": "^11.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "redis": "^6.1.0",
    "@socket.io/redis-adapter": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/aos": "^3.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.9",
    "daisyui": "^5.0.35"
  },
  "overrides": {
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=20.9.0 <21"
  }
}
