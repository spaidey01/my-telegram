[Unit]
Description=My Telegram Socket.IO server
After=network.target

[Service]
Type=simple
User=telegram
Group=telegram
WorkingDirectory=/opt/my-telegram
EnvironmentFile=/etc/my-telegram.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=027

[Install]
WantedBy=multi-user.target
