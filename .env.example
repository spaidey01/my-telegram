# Server-only secrets
secretKey=replace-with-a-long-random-secret

# MongoDB
MONGODB_URI=replace-with-mongodb-uri

# Socket server
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:3001

# S3-compatible storage (NEVER prefix these with NEXT_PUBLIC_)
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_ENDPOINT=https://your-s3-endpoint
S3_BUCKET_NAME=your-bucket

# TURN / WebRTC relay
# TURN_URL may contain comma-separated turn:/turns: URLs.
TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# Preferred: shared secret for short-lived TURN REST credentials.
# This secret must match coturn's static-auth-secret.
TURN_SECRET=replace-with-a-long-random-turn-secret
TURN_CREDENTIAL_TTL_SECONDS=600
# Fallback only when TURN_SECRET is not configured.
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_REALM=turn.example.com
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Optional / recommended in production
REDIS_URL=redis://localhost:6379
# Number of reverse proxies in front of Next.js (used to read the real client IP)
TRUSTED_PROXY_COUNT=1
# ClamAV: if CLAMAV_HOST is set, scanning is mandatory unless CLAMAV_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
